# Set explicitly: mock for a synthetic demo, supabase for the real network.
ATOMIC_BOND_DATA_MODE=
# Required in supabase mode. Use only an anon JWT or publishable key.
# NEXT_PUBLIC values are public and embedded in browser bundles at build time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only credentials. Never prefix these with NEXT_PUBLIC or serialize them.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPABASE_AUTH_HOOK_SECRET=
APP_ORIGIN=
AUTH_ALLOWED_ORIGINS=
AUTH_ALLOW_LOCALHOST=
# Growth-only server credential. Broad service-role authority; never browser-safe.
SUPABASE_GROWTH_SECRET_KEY=
CRON_SECRET=
# Disabled until controlled production acceptance passes; no cron is enabled yet.
GROWTH_EMAIL_ENABLED=
GROWTH_TEST_ATOM=
GROWTH_BATCH_SIZE=
GROWTH_SEND_CAP=

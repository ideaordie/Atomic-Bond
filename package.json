{
  "name": "atomic-bond",
  "version": "0.10.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:security:client && pnpm test:db:concurrency && pnpm build && pnpm test:e2e && pnpm test:e2e:persistence && pnpm test:e2e:auth",
    "test:security:client": "node scripts/test-growth-client-boundary.mjs",
    "test:db": "vitest run tests/integration/database.test.ts",
    "test:db:concurrency": "node scripts/test-db-concurrency.mjs",
    "test:e2e:persistence": "playwright test --config playwright.persistence.config.ts",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.5",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "standardwebhooks": "^1.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
